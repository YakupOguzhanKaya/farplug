<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.usbridge.client</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/usbridge</string>
    <string>--server</string><string>usbgw.local</string>
    <string>attach</string><string>zigbee</string>
    <string>--link</string><string>/Users/CHANGEME/.usbridge/dev/zigbee</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/usbridge.log</string>
</dict>
</plist>
