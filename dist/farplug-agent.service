# Owns the devices attached on this machine. Control it with `farplug` or
# `farplug-gui`; members of the `farplug` group may do so without sudo.
[Unit]
Description=farplug client agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=-/sbin/modprobe vhci-hcd
ExecStart=/usr/local/bin/farplug agent
Restart=always
RestartSec=2
Environment=RUST_LOG=info
RuntimeDirectory=farplug
RuntimeDirectoryMode=0755
StateDirectory=farplug

[Install]
WantedBy=multi-user.target
