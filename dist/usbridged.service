[Unit]
Description=usbridge USB serial gateway
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/usbridged --config /etc/usbridge/config.toml
Restart=always
RestartSec=2
Environment=RUST_LOG=info

# The daemon only needs the tty devices it exports.
User=usbridge
SupplementaryGroups=dialout
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=no
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
