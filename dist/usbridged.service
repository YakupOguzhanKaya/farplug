[Unit]
Description=usbridge USB/IP server
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=-/sbin/modprobe usbip-host
ExecStart=/usr/local/bin/usbridged --config /etc/usbridge/config.toml
Restart=always
RestartSec=2
Environment=RUST_LOG=info

# Binding devices to usbip-host means writing to /sys, which needs root.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
